# Codenotch does not require environment variables for a normal build or run.
# Copy this file to `.env` with `just config init`; uncomment only the optional
# development switches you need.

# Show fixed sample data in the native macOS app instead of live readings.
# CODENOTCH_DEMO=1

# Open a provider discovery URL in the native macOS app's signed-in WebView.
# CODENOTCH_DISCOVER=https://example.invalid/

# Optional provider/CLI profiles used by the native macOS implementation.
# CLAUDE_CONFIG_DIR=/absolute/path/to/.claude-work
# CODEX_HOME=/absolute/path/to/.codex-work
# OLLAMA_API_KEY=
