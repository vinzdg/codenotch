root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,markdown}]
trim_trailing_whitespace = false

[*.{tsv,tab}]
indent_style = tab

[Justfile]
indent_style = space
indent_size = 4

[*.just]
indent_style = space
indent_size = 4

[*.{yml,yaml,json}]
indent_size = 2

[*.ps1]
end_of_line = crlf
