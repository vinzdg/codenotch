    "Displays a notification card from the side of the notch when a provider's session or weekly usage limit is reached.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サービスのセッションまたは週間の使用量が上限に達したとき、ノッチの横から通知カードを表示します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当某家服务的会话或周额度用尽时，刘海侧面滑出一张通知卡片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當某家服務的工作階段或週額度用盡時，瀏海側面滑出一張通知卡片。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показує картку сповіщення збоку від вирізу, коли досягнуто сесійний або тижневий ліміт провайдера."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제공자의 세션 또는 주간 사용 한도에 도달하면 노치 옆에 알림 카드를 표시합니다."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Provayderning sessiya yoki haftalik foydalanish limitiga yetilganda notch yonidan bildirishnoma kartasini koʻrsatadi."
          }
        }
      }
    },
