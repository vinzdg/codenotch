        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir acesso…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许访问…"
          }
        }
      }
    },
    "Switch…": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Changer…"
          }
        },
