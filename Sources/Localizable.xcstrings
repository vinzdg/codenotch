          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Змініть акаунт у %@ — виріз оновиться."
          }
        }
      }
    },
    "Switch accounts in the tool that owns it; the notch follows.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Смените аккаунт в приложении, которому он принадлежит — выемка обновится."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Changez de compte dans l'outil qui le détient ; l'encoche suit."
