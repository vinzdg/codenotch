          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Codenotch 运行时，程序坞里有一个普通应用图标。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Codenotch 執行時，程式塢裡有一個普通 App 圖示。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein normales App-Symbol im Dock, solange Codenotch läuft."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Звичайний значок застосунку в Dock, поки Codenotch працює."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Codenotch가 실행 중일 때 Dock에 일반 앱 아이콘을 표시합니다."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Codenotch ishlab turganda Dockʼda oddiy ilova belgisi."
          }
        }
      }
    },
    "A small icon in the menu bar instead, and nothing in the Dock.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Небольшой значок в строке меню вместо значка в Dock."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une petite icône dans la barre des menus à la place, et rien dans le Dock."
