        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настоящие числа Antigravity и переключатель, который не включается обратно."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Antigravitys echte Zahlen, und ein Schalter, der ausgeschaltet bleibt."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Справжні числа Antigravity і перемикач, який лишається вимкненим."
          }
        }
      }
    },
    "Antigravity shows its actual quota": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Antigravity affiche son quota réel"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
