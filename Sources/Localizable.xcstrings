        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перший випуск."
          }
        }
      }
    },
    "Put the notch anywhere": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Placez l'encoche où vous voulez"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノッチをどこにでも配置"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloque o notch onde quiser"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "刘海可以放在任意一边"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "瀏海可以放在任意一邊"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разместите панель где угодно"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Notch überall platzieren"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розмістіть виріз де завгодно"
          }
        }
      }
    },
    "Right, left, top or bottom. It keeps clear of the Dock and the menu bar, and follows when the Dock moves.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Droite, gauche, haut ou bas. Elle reste à l'écart du Dock et de la barre des menus, et suit quand le Dock se déplace."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右、左、上、下。Dock とメニューバーを避け、Dock が移動すれば追従します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Direita, esquerda, em cima ou embaixo. Ele se mantém livre do Dock e da barra de menus, e acompanha quando o Dock se move."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "右、左、上或下。会避开程序坞和菜单栏，程序坞移动时跟着走。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "右、左、上或下。會避開程式塢和選單列，程式塢移動時跟著走。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Справа, слева, сверху или снизу. Панель не перекрывает Dock и строку меню и перемещается вместе с Dock."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechts, links, oben oder unten. Sie hält Abstand zu Dock und Menüleiste und folgt, wenn sich das Dock bewegt."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Праворуч, ліворуч, зверху або знизу. Не перекриває Dock і рядок меню та рухається разом із Dock."
          }
        }
      }
    },
    "It joins your Mac's own notch": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle rejoint l'encoche de votre Mac"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 自身のノッチと一体に"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ele se une ao notch do seu próprio Mac"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它会接上 Mac 自己的刘海"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它會接上 Mac 自己的瀏海"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Она объединяется с выемкой Mac"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie verschmilzt mit der Notch deines Mac"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зливається з вирізом вашого Mac"
          }
        }
      }
    },
    "On the top edge it takes the hardware's shape, so the two read as one rather than as a bar parked underneath.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur le bord supérieur, elle épouse la forme du matériel : les deux se lisent comme une seule forme plutôt que comme une barre garée en dessous."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上端では実機のノッチの形を取り込むので、下にバーが置かれているようにではなく、ひと続きに見えます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Na borda superior ele assume o formato do hardware, de modo que os dois formem uma só figura em vez de uma barra estacionada embaixo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "放在顶部时会采用硬件的形状，两者读起来是一块，而不是停在下面的一条。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "放在頂部時會採用硬體的形狀，兩者讀起來是一塊，而不是停在下面的一條。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У верхнего края она повторяет форму аппаратной выемки, поэтому выглядит единым элементом, а не панелью под ней."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Am oberen Rand nimmt sie die Form der Hardware an, sodass beide wie eine Einheit wirken statt wie ein darunter geparkter Balken."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Біля верхнього краю він повторює форму апаратного вирізу, тож обидва виглядають як одне ціле, а не як смуга під ним."
          }
        }
      }
    },
    "Claude, Cursor, Codex and Gemini": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude, Cursor, Codex et Gemini"
