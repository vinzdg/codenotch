    "Shows the current billing phase and the next peak/off-peak change on the DeepSeek usage card.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "DeepSeek の使用量カードに、現在の課金フェーズと、次のピーク/オフピークの切り替わりを表示します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 DeepSeek 用量卡片上显示当前计价阶段和下次峰谷切换时间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 DeepSeek 用量卡片上顯示目前計價階段和下次峰谷切換時間。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показує поточну фазу тарифікації та найближчу зміну пікового чи непікового періоду на картці використання DeepSeek."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "DeepSeek 사용량 카드에 현재 요금 구간과 다음 피크/오프피크 전환 시점을 표시합니다."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "DeepSeek foydalanish kartasida hozirgi hisob-kitob bosqichi va keyingi yuqori/past yuklama oʻzgarishini koʻrsatadi."
          }
        }
      }
    },
    "Peak rule": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
