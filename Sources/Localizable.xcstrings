    "Localhost": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Localhost"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "localhost"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
