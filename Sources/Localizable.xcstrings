    "Takes the least room on the edge. Readable, but not from across the desk.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prend le moins de place sur le bord. Lisible, mais pas de l'autre bout du bureau."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "辺で占める場所が最小。読めますが、机の向こうからは無理です。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocupa o mínimo de espaço na borda. Legível, mas não do outro lado da mesa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "边缘上占得最少。能读，但隔着桌子就不行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "邊緣上佔得最少。能讀，但隔著桌子就不行。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Занимает минимум места у края. Читается вблизи, но не издалека."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Braucht am Rand am wenigsten Platz. Lesbar, aber nicht quer über den Schreibtisch hinweg."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Займає найменше місця на краю. Читається зблизька, але не через увесь стіл."
          }
        }
      }
    },
    "The size the notch was drawn at.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La taille à laquelle l'encoche était dessinée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノッチが本来描かれるサイズ。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O tamanho com que o notch foi desenhado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "刘海绘制时的尺寸。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "瀏海繪製時的尺寸。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Размер, для которого была отрисована панель."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Größe, für die die Notch gezeichnet wurde."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розмір, для якого виріз і малювався."
          }
        }
      }
    },
    "Easier to read at a glance, and harder to ignore.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus facile à lire d'un coup d'œil, et plus difficile à ignorer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ひと目で読みやすく、無視しにくいサイズ。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mais fácil de ler de relance, e mais difícil de ignorar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一眼更好读，也更难忽视。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一眼更好讀，也更難忽視。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Легче читать одним взглядом, но сложнее не заметить."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf einen Blick leichter zu lesen, und schwerer zu übersehen."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Легше прочитати одним поглядом і важче не помітити."
          }
        }
      }
    },
    "Hold ⌥ and drag the notch to slide it along its edge. Each edge remembers where you left it.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez ⌥ et faites glisser l'encoche pour la déplacer le long de son bord. Chaque bord retient où vous l'avez laissée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⌥ を押しながらノッチをドラッグすると、辺に沿って動かせます。位置は辺ごとに記憶されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Segure ⌥ e arraste o notch para deslizá-lo ao longo da borda. Cada borda lembra onde você o deixou."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 ⌥ 拖动刘海，沿边缘滑动。每条边都会记住你放的位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 ⌥ 拖動瀏海，沿邊緣滑動。每條邊都會記住你放的位置。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удерживайте ⌥ и перетаскивайте панель вдоль края. Для каждого края запоминается последнее положение."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte ⌥ gedrückt und ziehe die Notch, um sie am Rand entlang zu verschieben. Jeder Rand merkt sich, wo du sie zuletzt abgelegt hast."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Утримуйте ⌥ і перетягніть виріз, щоб посунути його вздовж краю. Кожен край памʼятає останнє положення."
          }
        }
      }
    },
