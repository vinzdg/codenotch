    "Asks macOS for %@'s saved login again. Choose Always Allow and it will stop asking.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Redemande à macOS les identifiants enregistrés de %@. Choisissez Toujours autoriser et il cessera de demander."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ の保存済みログインを macOS に再度要求します。「常に許可」を選べば以後は尋ねられません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pede novamente ao macOS o login salvo do %@. Escolha Sempre Permitir e ele deixará de perguntar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "再次向 macOS 请求 %@ 已保存的登录信息。选「始终允许」就不会再问。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "再次向 macOS 要求 %@ 已儲存的登入資訊。選「始終允許」就不會再問。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Повторно запрашивает у macOS сохранённый вход %@. Выберите «Разрешать всегда», чтобы больше не видеть этот запрос."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fragt macOS erneut nach der gespeicherten Anmeldung von %@. Wähle „Immer erlauben“, damit nicht mehr nachgefragt wird."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Знову запитує в macOS збережений вхід %@. Виберіть «Завжди дозволяти» — і запити припиняться."
          }
        }
      }
    },
    "Switch off to stop reading %@ and forget its readings. %@": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivez pour arrêter de lire %@ et oublier ses relevés. %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフにすると %@ の読み取りを止め、その読み取りを忘れます。%@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desative para parar de ler o %@ e esquecer suas leituras. %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭后停止读取 %@ 并忘掉它的读数。%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉後停止讀取 %@ 並忘掉它的讀數。%@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключите, чтобы прекратить чтение %@ и удалить его показания. %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausschalten, um %@ nicht mehr zu lesen und dessen Messwerte zu vergessen. %@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вимкніть, щоб припинити читати %@ і забути його показники. %@"
          }
        }
      }
    },
    "Switch on to sign in and read %@ again.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez pour vous reconnecter et lire %@ à nouveau."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンにすると再びサインインして %@ を読み取ります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative para entrar e ler o %@ de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开以重新登录并读取 %@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟以重新登入並讀取 %@。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите, чтобы снова войти и читать %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einschalten, um dich anzumelden und %@ wieder zu lesen."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увімкніть, щоб знову увійти й читати %@."
          }
        }
      }
    },
    "Codenotch is not reading %@'s saved login. Choose Allow access… above and answer Allow.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Codenotch ne lit pas la connexion enregistrée de %@. Choisissez Autoriser l'accès… ci-dessus et répondez Autoriser."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Codenotch は %@ の保存済みログインを読んでいません。上の「アクセスを許可…」を選び、「許可」と答えてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Codenotch não está lendo o login salvo de %@. Escolha Permitir acesso… acima e responda Permitir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Codenotch 没有读取 %@ 保存的登录信息。请在上方选择“允许访问…”，然后选择“允许”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Codenotch 沒有讀取 %@ 儲存的登入資訊。請在上方選擇“允許取用…”，然後選擇“允許”。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Codenotch не читает сохранённый вход %@. Выберите «Разрешить доступ…» выше и ответьте «Разрешить»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Codenotch liest die gespeicherte Anmeldung von %@ nicht. Wähle oben „Zugriff erlauben…“ und antworte mit „Erlauben“."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Codenotch не читає збережений вхід %@. Виберіть «Дозволити доступ…» вище й дайте відповідь «Дозволити»."
          }
        }
      }
    },
    "Open %@": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrir %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ を開く"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir o %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
