    "Sign in with GitHub CLI to read your Copilot usage": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous avec la CLI GitHub pour lire votre consommation Copilot"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Copilot の使用量を読み取るには GitHub CLI でサインイン"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Entre com a CLI do GitHub para ler seu uso do Copilot"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用 GitHub CLI 登录以读取 Copilot 用量"
          }
        },
