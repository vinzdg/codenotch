    "One ring per provider, showing the headline limit. The weekly allowance stays in the hover card.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サービスごとに 1 本のリングで主な上限を表示します。週間の枠はホバーカードに残ります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个服务一个圆环，显示主额度。每周额度仍在提示卡里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個服務一個圓環，顯示主額度。每週額度仍在提示卡裡。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одно кольцо на провайдера с основным лимитом. Недельная квота остаётся в карточке при наведении."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Ring pro Anbieter, der das Hauptlimit zeigt. Das Wochenkontingent bleibt in der Hover-Karte."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Одне кільце на провайдера з головним лімітом. Тижневий ліміт лишається в картці при наведенні."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제공자당 하나의 링으로 주요 한도를 표시합니다. 주간 할당량은 호버 카드에 표시합니다."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Har bir provayder uchun bitta halqa — asosiy limitni koʻrsatadi. Haftalik ruxsat maslahat kartasida qoladi."
          }
        }
      }
    },
    "A thinner ring for the weekly limit, drawn inside the main one. It shares the gap with the working indicator.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "週間の上限を細いリングで主リングの内側に描きます。作業中インジケータと同じ隙間を共有します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一条更细的每周额度圆环，画在主环内侧。和工作指示共用那个空隙。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一條更細的每週額度圓環，畫在主環內側。和工作指示共用那個空隙。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тонкое кольцо недельного лимита внутри основного. Оно делит зазор с индикатором работы."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein dünnerer Ring für das Wochenlimit, innerhalb des Hauptrings gezogen. Er teilt sich den Zwischenraum mit der Arbeitsanzeige."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тонше кільце тижневого ліміту всередині основного. Воно ділить проміжок з індикатором роботи."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본 링 안쪽에 주간 한도를 얇은 링으로 표시합니다. 작업 중 표시와 같은 간격을 사용합니다."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Haftalik limit uchun ingichkaroq halqa — asosiysining ichida chiziladi. U boʻshliqni ish holati indikatori bilan boʻlishadi."
          }
        }
      }
    },
    "A thinner ring for the weekly limit, drawn around the main one, in the margin between the ring and the notch edge.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "週間の上限を細いリングで主リングの外側、リングとノッチの端の間の余白に描きます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一条更细的每周额度圆环，画在主环外侧，圆环和刘海边缘之间的空隙里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一條更細的每週額度圓環，畫在主環外側，圓環和瀏海邊緣之間的空隙裡。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тонкое кольцо недельного лимита вокруг основного, в промежутке между кольцом и краем панели."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein dünnerer Ring für das Wochenlimit, außen um den Hauptring gezogen, im Zwischenraum zwischen Ring und Notch-Rand."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тонше кільце тижневого ліміту навколо основного, у проміжку між кільцем і краєм вирізу."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본 링과 노치 가장자리 사이의 여백에 주간 한도를 얇은 링으로 표시합니다."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Haftalik limit uchun ingichkaroq halqa — asosiysining atrofida, halqa bilan notch chekkasi orasidagi boʻshliqda chiziladi."
          }
        }
      }
    },
    "Run %@ in Terminal to sign in to %@.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ をターミナルで実行して %@ にサインインしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在终端运行 %@ 以登录 %@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在終端執行 %@ 以登入 %@。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запустите %@ в Терминале, чтобы войти в %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Führe %@ im Terminal aus, um dich bei %@ anzumelden."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запустіть %@ у Терміналі, щоб увійти в %@."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@을(를) 터미널에서 실행해 %@에 로그인하십시오."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ ga kirish uchun Terminalda %1$@ ni ishga tushiring."
          }
        }
      }
    },
