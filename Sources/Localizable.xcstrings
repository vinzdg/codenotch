    "Your phone reads usage from this Mac over your Wi-Fi. Nothing leaves your network.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマートフォンは Wi-Fi 経由でこの Mac から使用量を読み取ります。ネットワークの外には何も出ません。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Телефон читає дані про використання з цього Mac через ваш Wi-Fi. Нічого не виходить за межі мережі."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手机通过 Wi-Fi 读取这台 Mac 的用量。什么都不会离开你的网络。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的手機會透過 Wi-Fi 從此 Mac 讀取用量。資料不會離開你的網路。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴대전화가 Wi-Fi를 통해 이 Mac의 사용량을 읽습니다. 네트워크 밖으로는 아무것도 전송하지 않습니다."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefoningiz foydalanishni shu Macʼdan Wi-Fi orqali oʻqiydi. Hech narsa tarmogʻingizdan tashqariga chiqmaydi."
          }
        }
