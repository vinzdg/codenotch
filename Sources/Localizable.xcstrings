          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mehrere Claude-Code-Konten"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кілька акаунтів Claude Code"
