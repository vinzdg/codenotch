        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Суцільний чорний"
          }
        }
      }
    },
    "Dark glass": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダークガラス"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "深色玻璃"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "深色玻璃"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тёмное стекло"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dunkles Glas"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Темне скло"
          }
        }
