    "The notch stays open with every reading visible.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выемка остаётся открытой, и все данные видны."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'encoche reste ouverte, tous les relevés visibles."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノッチは開いたままで、すべての読み取りが見えます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O notch fica aberto com todas as leituras visíveis."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "刘海保持展开，所有读数都看得见。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "瀏海保持展開，所有讀數都看得見。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Notch bleibt offen, mit allen Messwerten sichtbar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виріз лишається відкритим, усі показники видно."
          }
        }
      }
    },
    "A small pill at the screen edge that opens when you reach it.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Небольшая панель у края экрана, которая открывается при наведении."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une petite pastille au bord de l'écran, qui s'ouvre quand vous l'atteignez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面の端に小さなピル。ポインタを近づけると開きます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma pequena cápsula na borda da tela que abre quando você chega nela."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屏幕边缘一颗小胶囊，指针移过去就会展开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "螢幕邊緣一顆小膠囊，游標移過去就會展開。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine kleine Pille am Bildschirmrand, die sich öffnet, sobald du sie erreichst."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Невелика смужка біля краю екрана, що розгортається при наведенні."
          }
        }
      }
    },
    "Nothing on screen. Open Codenotch again from Applications to bring these settings back.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ничего не показывать. Откройте Codenotch снова из Программ, чтобы вернуть эти настройки."
          }
        },
        "fr": {
