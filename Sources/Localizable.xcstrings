    "Sign in with the Command Code app — it writes ~/.commandcode/auth.json and the notch reads it.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous avec l'app Command Code — elle écrit ~/.commandcode/auth.json et l'encoche le lit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Command Code アプリでサインインしてください。~/.commandcode/auth.json が書き出され、ノッチがそれを読み取ります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Entre com o app Command Code — ele escreve ~/.commandcode/auth.json e o notch o lê."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用 Command Code 应用登录 — 它会写入 ~/.commandcode/auth.json，刘海会读它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用 Command Code App登入 — 它會寫入 ~/.commandcode/auth.json，瀏海會讀它。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Войдите через приложение Command Code — оно записывает ~/.commandcode/auth.json, откуда панель читает данные."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich mit der Command-Code-App an — sie schreibt ~/.commandcode/auth.json, und die Notch liest diese Datei."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увійдіть через застосунок Command Code — він записує ~/.commandcode/auth.json, а виріз читає цей файл."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Command Code 앱으로 로그인하십시오. 앱이 ~/.commandcode/auth.json에 기록하면 노치가 읽습니다."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Command Code ilovasi orqali kiring — u ~/.commandcode/auth.json ni yozadi, notch esa uni oʻqiydi."
          }
        }
      }
    },
    "Command Code has nothing metered on this account yet": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Command Code n'a encore rien de mesuré sur ce compte"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアカウントには、Command Code が計測する対象がまだありません"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Command Code ainda não tem nada medido nesta conta"
          }
        },
        "zh-Hans": {
