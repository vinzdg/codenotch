    },
    "Loaded models appear in Accounts → Connected and are checked every second. Embedding models are not shown.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geladene Modelle erscheinen unter Konten → Verbunden und werden jede Sekunde geprüft. Embedding-Modelle werden nicht angezeigt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み込まれたモデルは「アカウント」→「接続済み」に表示され、1 秒ごとに確認されます。埋め込みモデルは表示されません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已加载的模型会出现在「账号 → 已连接」，每秒检查一次。不显示嵌入模型。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已載入的模型會出現在「帳號 → 已連線」，每秒檢查一次。不顯示嵌入模型。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завантажені моделі зʼявляються в «Акаунти → Підключені» й перевіряються щосекунди. Моделі ембедингів не показуються."
          }
        }
      }
    },
    "A token is stored and sent with every request.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Token wird gespeichert und mit jeder Anfrage gesendet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トークンを保存し、すべてのリクエストに添えて送信します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存令牌，每次请求都会带上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已儲存權杖，每次要求都會帶上。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Токен зберігається і надсилається з кожним запитом."
          }
        }
      }
    },
    "Only needed when LM Studio's server requires a token (Developer → Server Settings). Without one, requests are sent with no Authorization header.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur nötig, wenn der Server von LM Studio ein Token verlangt (Developer → Server Settings). Ohne Token werden Anfragen ohne Authorization-Header gesendet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "LM Studio のサーバーがトークンを要求する場合にのみ必要です（Developer → Server Settings）。設定しない場合、リクエストは Authorization ヘッダーなしで送信されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅当 LM Studio 服务器要求令牌时才需要（开发者 → 服务器设置）。不填则请求不带 Authorization 头。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅當 LM Studio 伺服器要求權杖時才需要（開發人員 → 伺服器設定）。不填則要求不帶 Authorization 標頭。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Потрібно лише тоді, коли сервер LM Studio вимагає токен (Developer → Server Settings). Без нього запити надсилаються без заголовка Authorization."
          }
        }
      }
    },
    "Detected models appear in Accounts → Connected. Model loading and unloading is checked every second.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erkannte Modelle erscheinen unter Konten → Verbunden. Laden und Entladen von Modellen wird jede Sekunde geprüft."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検出されたモデルは「アカウント」→「接続済み」に表示されます。モデルの読み込みと解放は 1 秒ごとに確認されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检测到的模型会出现在「账号 → 已连接」。模型加载和卸载每秒检查一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "偵測到的模型會出現在「帳號 → 已連線」。模型載入與卸載每秒檢查一次。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виявлені моделі зʼявляються в розділі «Акаунти → Підключені». Завантаження та вивантаження моделей перевіряється щосекунди."
          }
        }
      }
    },
