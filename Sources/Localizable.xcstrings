            "state": "translated",
            "value": "A cota semanal do Grok Build no SuperGrok, lida do mesmo endpoint de cobrança que a CLI usa, com a sessão em ~/.grok/auth.json."
          }
        },
        "zh-Hans": {
          "stringUnit": {
