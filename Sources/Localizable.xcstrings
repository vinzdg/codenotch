    },
    "Enable monitoring in the runtime's settings to show its models.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez la surveillance dans les réglages du runtime pour afficher ses modèles."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
