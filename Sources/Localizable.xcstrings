            "value": "首个版本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "首個版本。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Первый выпуск."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die erste Version."
          }
        },
        "uk": {
          "stringUnit": {
