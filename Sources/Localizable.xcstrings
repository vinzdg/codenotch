          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Читає ендпоінт ліміту Copilot у GitHub через сесію GitHub CLI, яка вже є на Mac."
          }
        }
      }
    },
    "Say when a session ends": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Signaler la fin d'une session"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セッションの終了を知らせる"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Avise quando uma sessão terminar"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会话结束时会告诉你"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "工作階段結束時會告訴你"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сообщать о завершении сеанса"
          }
        },
        "de": {
          "stringUnit": {
