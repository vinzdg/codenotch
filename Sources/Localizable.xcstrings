    "Opens %@, which is where this account is signed in.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre %@, où ce compte est connecté."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアカウントがサインインしている %@ を開きます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre o %@, que é onde esta conta está conectada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 %@，这个账号就是在那里登录的。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟 %@，這個帳號就是在那裡登入的。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывает %@, где выполнен вход в этот аккаунт."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet %@ — dort ist dieses Konto angemeldet."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкриває %@ — саме там виконано вхід у цей акаунт."
          }
        }
      }
    },
    "Opens %@ in your browser. That site has its own sign-in, separate from the credential read here.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre %@ dans votre navigateur. Ce site a sa propre connexion, distincte de l'identifiant lu ici."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブラウザで %@ を開きます。このサイトには独自のサインインがあり、ここで読み取っている資格情報とは別のものです。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre o %@ no seu navegador. Esse site tem o login próprio dele, separado da credencial lida aqui."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在浏览器打开 %@。那个网站有自己的登录，和这里读取的凭证不是一回事。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在瀏覽器開啟 %@。那個網站有自己的登入，和這裡讀取的憑證不是一回事。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывает %@ в браузере. На этом сайте используется отдельный вход, не связанный с читаемыми здесь данными."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet %@ in deinem Browser. Diese Seite hat eine eigene Anmeldung, getrennt von den hier gelesenen Zugangsdaten."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкриває %@ у браузері. Той сайт має власний вхід, окремий від облікових даних, які читаються тут."
          }
        }
      }
    },
