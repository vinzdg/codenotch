    },
    "Times are editable: click a value, change it and press Return. The running block is shown live and cannot be edited until it stops.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os horários são editáveis: clique num valor, altere e pressione Return. O bloco em andamento aparece ao vivo e só pode ser editado depois de parar."
          }
        }
      }
    },
