    "Run `%@` once — it signs in and is what these readings come from. Use /login there to change account.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exécutez `%@` une fois — il vous connecte et c'est de là que viennent ces relevés. Utilisez /login là-bas pour changer de compte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "`%@` を一度実行してください。サインインし、ここでの読み取りはそこから得られます。アカウントを変えるには、そこで /login を使います。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Execute `%@` uma vez — ele faz o login e é a origem destas leituras. Use /login lá para trocar de conta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先运行一次 `%@` — 它会登录，读数就来自那里。要换账号，在那里用 /login。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "先執行一次 `%@` — 它會登入，讀數就來自那裡。要換帳號，在那裡用 /login。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Один раз запустите `%@` — команда выполнит вход и станет источником этих показаний. Для смены аккаунта используйте там /login."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Führe einmal `%@` aus — das meldet dich an, und daher stammen diese Messwerte. Verwende dort /login, um das Konto zu wechseln."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запустіть `%@` один раз — команда виконує вхід, і саме звідти беруться ці показники. Щоб змінити акаунт, введіть там /login."
          }
        }
      }
    },
