    "Sign in to Codex in ~/.codex-%@ to read your usage": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous à Codex dans ~/.codex-%@ pour lire votre consommation"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使用量を読み取るには ~/.codex-%@ で Codex にサインイン"
          }
        },
        "pt-BR": {
          "stringUnit": {
