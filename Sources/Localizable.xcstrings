    "Long enough to notice, short enough to ignore.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Assez long pour être remarqué, assez court pour être ignoré."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "気づく程度に長く、無視できる程度に短く。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempo suficiente para notar, curto o bastante para ignorar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "够注意到，也够被忽略。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "夠注意到，也夠被忽略。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Достаточно долго, чтобы заметить, и достаточно коротко, чтобы не мешать."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lang genug, um es zu bemerken, kurz genug, um es zu ignorieren."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Досить довго, щоб помітити, і досить коротко, щоб не заважати."
          }
        }
      }
    },
    "Long enough to read the session's name and reach for it.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Assez long pour lire le nom de la session et l'atteindre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セッション名を読んで手を伸ばせる程度の長さ。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempo suficiente para ler o nome da sessão e alcançá-la."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "够读完会话名称并伸手过去。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "夠讀完工作階段名稱並伸手過去。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Достаточно долго, чтобы прочитать название сеанса и открыть его."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lang genug, um den Namen der Sitzung zu lesen und danach zu greifen."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Досить довго, щоб прочитати назву сесії й перейти до неї."
          }
        }
      }
    },
    "Stays until you have had a chance to look up.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reste jusqu'à ce que vous ayez eu l'occasion de lever les yeux."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "顔を上げる余裕ができるまで残ります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permanece até você ter tido a chance de olhar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会一直留到你有机会抬头看。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "會一直留到你有機會抬頭看。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остаётся открытой, пока вы не успеете на неё посмотреть."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bleibt, bis du die Gelegenheit hattest, hinzusehen."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тримається, доки ви не встигнете підвести погляд."
          }
        }
      }
    },
