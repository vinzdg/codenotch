    "That display is disconnected. Codenotch follows the active window until it returns.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet écran est déconnecté. Codenotch suit la fenêtre active jusqu'à son retour."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのディスプレイは接続されていません。復帰するまで、Codenotch はアクティブなウインドウに追従します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Essa tela está desconectada. O Codenotch acompanha a janela ativa até ela voltar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "那台显示器已断开。Codenotch 会跟随活动窗口，直到它回来。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "那台顯示器已斷開。Codenotch 會跟隨活動視窗，直到它回來。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот дисплей отключён. Codenotch следует за активным окном, пока дисплей не вернётся."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Bildschirm ist getrennt. Codenotch folgt dem aktiven Fenster, bis er zurückkommt."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей дисплей відʼєднано. Codenotch стежить за активним вікном, доки дисплей не повернеться."
          }
        }
      }
    },
    "Drag to reorder. The notch draws the rings in this order.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser pour réordonner. L'encoche dessine les anneaux dans cet ordre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドラッグして並べ替えます。ノッチはこの順にリングを描きます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste para reordenar. O notch desenha os anéis nesta ordem."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动以改顺序。刘海按这个顺序画圆环。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖動以改順序。瀏海按這個順序畫圓環。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетащите, чтобы изменить порядок. Панель отображает кольца в этом порядке."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehen, um die Reihenfolge zu ändern. Die Notch zeichnet die Ringe in dieser Reihenfolge."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетягніть, щоб змінити порядок. Виріз показує кільця саме в цьому порядку."
          }
        }
      }
    },
    "Switch this on to give it a ring in the notch.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez ceci pour lui donner un anneau dans l'encoche."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンにすると、ノッチにリングが追加されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative isto para dar a ele um anel no notch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开后，刘海里会出现它的圆环。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟後，瀏海裡會出現它的圓環。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите, чтобы добавить провайдеру кольцо на панели."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte das ein, um ihm einen Ring in der Notch zu geben."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увімкніть, щоб дати йому кільце у вирізі."
          }
        }
      }
    },
    "Alerts for %@ are muted. Click to unmute.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les alertes pour %@ sont coupées. Cliquez pour les réactiver."
