          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub Copilot 成了新的圆环"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub Copilot 成了新的圓環"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
