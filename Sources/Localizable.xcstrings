    "Run kimi and sign in with /login — it writes and refreshes the token this reads.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "kimi を実行し、/login でサインインしてください。ここで読み取るトークンが書き出され、更新されます。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запустіть kimi і увійдіть через /login — так записується й оновлюється токен, який читає Codenotch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "运行 kimi 并用 /login 登录 — 它会写入并刷新这里读取的令牌。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "執行 kimi 並用 /login 登入 — 它會寫入並重新整理這裡讀取的權杖。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "kimi를 실행하고 /login으로 로그인하십시오. 여기서 읽는 토큰을 저장하고 갱신합니다."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "kimi ni ishga tushiring va /login orqali kiring — u bu oʻqiydigan tokenni yozadi va yangilaydi."
