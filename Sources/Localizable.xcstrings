        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在下方填写 Ollama API 密钥，或在 shell 里导出 OLLAMA_API_KEY。"
          }
        }
      }
    },
    "Sign in with the Command Code app — it writes ~/.commandcode/auth.json and the notch reads it.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous avec l'app Command Code — elle écrit ~/.commandcode/auth.json et l'encoche le lit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Command Code アプリでサインインしてください。~/.commandcode/auth.json が書き出され、ノッチがそれを読み取ります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Entre com o app Command Code — ele escreve ~/.commandcode/auth.json e o notch o lê."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用 Command Code 应用登录 — 它会写入 ~/.commandcode/auth.json，刘海会读它。"
          }
        }
      }
    },
    "Command Code has nothing metered on this account yet": {
