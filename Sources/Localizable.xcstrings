    "To measure responses, point your chat client to http://127.0.0.1:11435 and keep Codenotch open.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um Antworten zu messen, richte deinen Chat-Client auf http://127.0.0.1:11435 und lass Codenotch geöffnet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "応答を計測するには、チャットクライアントの向き先を http://127.0.0.1:11435 にして、Codenotch を開いたままにしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要测量回复，把聊天客户端指向 http://127.0.0.1:11435，并保持 Codenotch 打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要測量回復，把聊天客戶端指向 http://127.0.0.1:11435，並保持 Codenotch 開啟。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб вимірювати відповіді, спрямуйте свій чат-клієнт на http://127.0.0.1:11435 і не закривайте Codenotch."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "응답을 측정하려면 채팅 클라이언트의 주소를 http://127.0.0.1:11435로 설정하고 Codenotch를 열어 두십시오."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Javoblarni oʻlchash uchun chat mijozingizni http://127.0.0.1:11435 ga yoʻnaltiring va Codenotchʼni ochiq qoldiring."
          }
        }
      }
    },
    "Allow phones on this network": {
