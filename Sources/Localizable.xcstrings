    "Minutes under an hour; otherwise the reset date and time.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des minutes en dessous d'une heure ; sinon la date et l'heure de réinitialisation."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1 時間未満なら分、それ以外はリセットの日時。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Minutos quando falta menos de uma hora; caso contrário, a data e a hora da renovação."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不足一小时显示分钟；否则显示重置日期和时间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不足一小時顯示分鐘；否則顯示重置日期和時間。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Минуты, если до сброса меньше часа; иначе дата и время сброса."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Minuten bei unter einer Stunde; sonst Datum und Uhrzeit der Zurücksetzung."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Хвилини, якщо лишилося менше години; інакше — дата й час скидання."
          }
        }
      }
    },
    "Time until usage resets, such as 3 Days 3h or 3h 20m.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Temps avant la réinitialisation de la consommation, par exemple 3 j 3h ou 3h 20m."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使用量がリセットされるまでの時間。「3 日 3 時間」「3 時間 20 分」など。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempo até o uso renovar, como 3 dias 3h ou 3h 20m."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "距离用量重置还有多久，例如 3 Days 3h 或 3h 20m。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "距離用量重置還有多久，例如 3 Days 3h 或 3h 20m。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Время до сброса использования, например 3 дня 3 ч или 3 ч 20 мин."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeit bis zur Zurücksetzung der Nutzung, etwa 3 Tage 3 Std. oder 3 Std. 20 Min."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Час до скидання використання, наприклад 3 дні 3 год або 3 год 20 хв."
          }
        }
      }
    },
