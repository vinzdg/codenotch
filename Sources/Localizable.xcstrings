          }
        }
      }
    },
    "In the Dock, in the menu bar, or nowhere at all.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans le Dock, dans la barre des menus, ou nulle part."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock、メニューバー、またはどこにも出さない。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No Dock, na barra de menus, ou em lugar nenhum."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在程序坞、在菜单栏，或者哪里都不出现。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在程式塢、在選單列，或者哪裡都不出現。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В Dock, в строке меню или нигде."
          }
        },
        "de": {
