    "The notch appears only on the display with the menu bar.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'encoche n'apparaît que sur l'écran qui porte la barre des menus."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノッチはメニューバーのあるディスプレイにだけ出ます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O notch aparece apenas na tela que tem a barra de menus."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "刘海只出现在有菜单栏的显示器上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "瀏海只出現在有選單列的顯示器上。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Панель появляется только на дисплее со строкой меню."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Notch erscheint nur auf dem Bildschirm mit der Menüleiste."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виріз зʼявляється лише на дисплеї з рядком меню."
          }
        }
      }
    },
    "Each display gets its own notch, and hovering one opens only that one.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque écran a sa propre encoche, et en survoler une n'ouvre que celle-là."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディスプレイごとに独自のノッチが出ます。ホバーしたものだけが開きます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada tela ganha o próprio notch, e passar o cursor sobre um abre somente aquele."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个显示器各有一个刘海，悬停只会打开那一个。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個顯示器各有一個瀏海，懸停只會開啟那一個。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На каждом дисплее есть своя панель, и наведение открывает только её."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Bildschirm bekommt seine eigene Notch, und Hover öffnet jeweils nur diese eine."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожен дисплей отримує власний виріз, і наведення відкриває лише його."
          }
        }
      }
    },
