    "Still in focus after %lld h": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda em foco após %lld h"
          }
        }
      }
    },
    "Switch the Tasks ring on in Accounts. Things 3 needs the Automation permission; Reminders asks for access to your reminders; Todoist needs an API token.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative o anel Tarefas em Contas. O Things 3 precisa da permissão de Automação; os Lembretes pedem acesso aos seus lembretes; o Todoist precisa de um token da API."
          }
        }
      }
    },
