          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увійдіть через GitHub CLI командою `gh auth login`, потім увімкніть GitHub Copilot."
          }
        }
      }
    },
    "GitHub Copilot reported no metered quotas": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub Copilot n'a signalé aucun quota mesuré"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub Copilot は計測対象の割り当てを返しませんでした"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O GitHub Copilot não informou nenhuma cota medida"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub Copilot 没有返回可计量的配额"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub Copilot 沒有返回可計量的配額"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub Copilot не сообщил измеряемых квот"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub Copilot hat keine messbaren Kontingente gemeldet"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub Copilot не повідомив про вимірювані ліміти"
          }
        }
      }
    },
    "There is nothing to sign in to: the count is added up from what Gemini CLI, OpenCode and Hermes recorded about their own calls. Your API key is never read.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n'y a rien à quoi se connecter : le total est additionné à partir de ce que Gemini CLI, OpenCode et Hermes ont enregistré sur leurs propres appels. Votre clé API n'est jamais lue."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインインする先はありません。この件数は、Gemini CLI、OpenCode、Hermes が自分の呼び出しについて記録した内容を合算したものです。API キーが読み取られることはありません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há onde entrar: a contagem é somada a partir do que a CLI do Gemini, o OpenCode e o Hermes registraram sobre as próprias chamadas. Sua chave de API nunca é lida."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有需要登录的地方：次数是从 Gemini CLI、OpenCode 和 Hermes 自己记录的调用加总的。不会读取你的 API 密钥。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有需要登入的地方：次數是從 Gemini CLI、OpenCode 和 Hermes 自己記錄的呼叫加總的。不會讀取你的 API 金鑰。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вход не требуется: показатель складывается из данных о собственных вызовах Gemini CLI, OpenCode и Hermes. Ваш API-ключ никогда не читается."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gibt nichts, wo man sich anmelden müsste: Die Zahl wird aus dem zusammengerechnet, was Gemini CLI, OpenCode und Hermes über ihre eigenen Aufrufe aufgezeichnet haben. Dein API-Schlüssel wird nie gelesen."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Входити нікуди: лічильник складається з того, що Gemini CLI, OpenCode і Hermes записали про власні виклики. Ваш API-ключ ніколи не читається."
          }
        }
      }
    },
