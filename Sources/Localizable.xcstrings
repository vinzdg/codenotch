    "Down the right-hand edge, clear of a Dock on that side.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le long du bord droit, à l'écart d'un Dock placé de ce côté."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右端に沿って。その側の Dock は避けます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao longo da borda direita, livre de um Dock desse lado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "沿右边缘，避开那一侧的程序坞。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沿右邊緣，避開那一側的程式塢。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вдоль правого края, не занимая место у Dock."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Am rechten Rand entlang, mit Abstand zu einem Dock auf dieser Seite."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Уздовж правого краю, не перекриваючи Dock, якщо він з того боку."
          }
        }
      }
    },
    "Down the left-hand edge, clear of a Dock on that side.": {
      "extractionState": "manual",
      "localizations": {
        "fr": {
